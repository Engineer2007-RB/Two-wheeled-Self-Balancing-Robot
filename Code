void handleSetPID() {
    if (server.hasArg("kp")) Kp = server.arg("kp").toFloat();
    if (server.hasArg("ki")) Ki = server.arg("ki").toFloat();
    if (server.hasArg("kd")) Kd = server.arg("kd").toFloat();
    if (server.hasArg("sp")) setpoint = server.arg("sp").toFloat();
    integral = 0;
    Serial.printf("Angle PID: Kp=%.4f Ki=%.4f Kd=%.4f Setpoint=%.2f\n", Kp, Ki, Kd, setpoint);
    server.sendHeader("Location", "/"); server.send(303);
}

void handleSetPosPID() {
    if (server.hasArg("pkp")) posKp = server.arg("pkp").toFloat();
    if (server.hasArg("pki")) posKi = server.arg("pki").toFloat();
    if (server.hasArg("pkd")) posKd = server.arg("pkd").toFloat();
    posIntegral = 0;
    Serial.printf("Pos PID: posKp=%.6f posKi=%.6f posKd=%.6f\n", posKp, posKi, posKd);
    server.sendHeader("Location", "/"); server.send(303);
}

void handleResetPos() {
    portDISABLE_INTERRUPTS();
    positionSteps = 0;
    posIntegral   = 0;
    lastPosError  = 0;
    portENABLE_INTERRUPTS();
    Serial.println("Position reset to 0");
    server.sendHeader("Location", "/"); server.send(303);
}

void handleSetMotor() {
    if (server.hasArg("maxf")) MAX_FREQUENCY = server.arg("maxf").toFloat();
    if (server.hasArg("minf")) MIN_FREQUENCY = server.arg("minf").toFloat();
    if (server.hasArg("db"))   DEADBAND      = server.arg("db").toFloat();
    Serial.printf("Motor: MaxFreq=%.0f MinFreq=%.0f Deadband=%.4f\n", MAX_FREQUENCY, MIN_FREQUENCY, DEADBAND);
    server.sendHeader("Location", "/"); server.send(303);
}

void handleSetKalman() {
    if (server.hasArg("qa")) Q_angle   = server.arg("qa").toFloat();

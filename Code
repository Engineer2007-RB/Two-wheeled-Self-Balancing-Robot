// ── Position PID ──────────────────────────────────────────────
// Uses step-pulse counting as virtual encoder (no hardware encoder needed).
// Output nudges the angle setpoint to correct drift.
//
// How it works:
//   • stepCallback() increments/decrements positionSteps on every pulse
//   • positionPID reads positionSteps, computes an angle trim
//   • The angle loop chases (setpoint + angleTrim) instead of bare setpoint
//   • If robot drifts forward → positive step count → negative angle trim
//     → robot leans back slightly → corrects drift
//
volatile long positionSteps = 0;   // counts pulses (+fwd / −rev)
volatile int  currentDir    = 1;   // +1 = forward, -1 = reverse

float posKp = 0.0003f;   // position P gain  (start very small!)
float posKi = 0.0f;      // position I gain  (usually leave 0)
float posKd = 0.0001f;   // position D gain  (damps position oscillation)
float posDerivFiltered = 0.0f;
const float POS_DERIV_ALPHA = 0.1f;  // 0.0=heavy filter, 1.0=no filter. Start at 0.1

float posIntegral    = 0.0f;
float lastPosError   = 0.0f;
float angleTrim      = 0.0f;       // output of position PID → added to setpoint

const float MAX_ANGLE_TRIM   = 5.0f;    // max degrees the position loop can shift setpoint
const float MAX_POS_INTEGRAL = 5000.0f; // anti-windup for position integral

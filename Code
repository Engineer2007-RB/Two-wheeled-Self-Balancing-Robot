// ======================== SETUP ========================
void setup() {
    Serial.begin(115200);

    pinMode(PUL1, OUTPUT); pinMode(PUL2, OUTPUT);
    pinMode(DIR1, OUTPUT); pinMode(DIR2, OUTPUT);
    pinMode(ENA1, OUTPUT); pinMode(ENA2, OUTPUT);
    digitalWrite(ENA1, LOW);
    digitalWrite(ENA2, LOW);
    digitalWrite(PUL1, LOW);
    digitalWrite(PUL2, LOW);

    Wire.begin(SDA_PIN, SCL_PIN);
    Wire.setClock(400000);
    mpu.initialize();
    mpu.setDLPFMode(3);

    Serial.println("Calibrating gyro... keep robot still");
    delay(2000);
    long sum = 0;
    int16_t ax, ay, az, gx, gy, gz;
    for (int i = 0; i < 2000; i++) {
        mpu.getMotion6(&ax, &ay, &az, &gx, &gy, &gz);
        sum += gx;
        delay(2);
    }
    gyroOffsetX = sum / 2000.0f;
    Serial.printf("Gyro offset: %.2f\n", gyroOffsetX);

    mpu.getMotion6(&ax, &ay, &az, &gx, &gy, &gz);
    angle = atan2(ay, sqrt((float)ax*ax + (float)az*az)) * 180.0f / PI;
    prevTime = micros();

    const esp_timer_create_args_t timerArgs = {
        .callback = &stepCallback,
        .arg = NULL,
        .name = "stepperTimer"
    };
    esp_timer_create(&timerArgs, &stepTimer);

    WiFi.begin(ssid, password);
    Serial.print("Connecting to WiFi");
    while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
    Serial.printf("\nConnected. IP: %s\n", WiFi.localIP().toString().c_str());

    server.on("/",          handleRoot);
    server.on("/setPID",    handleSetPID);
    server.on("/setPosPID", handleSetPosPID);   // NEW
    server.on("/resetPos",  handleResetPos);    // NEW
    server.on("/setMotor",  handleSetMotor);
    server.on("/setKalman", handleSetKalman);
    server.begin();

    Serial.println("\nRobot ready.");
    Serial.println("─── Serial Commands ───────────────────────────────────────");
    Serial.println("Angle PID : KP / KI / KD / SP");
    Serial.println("Pos PID   : PKP / PKI / PKD   (e.g. PKP0.0003)");
    Serial.println("Motor     : MAXF / MINF / DB");
    Serial.println("Kalman    : QA / QB / RM");
    Serial.println("Util      : SHOW / SHOWK / SHOWP / RESETPOS");
    Serial.println("───────────────────────────────────────────────────────────");
}

// ======================== LOOP ========================
void loop() {
    server.handleClient();
    readPIDCommands();

    unsigned long now = millis();
    if (now - lastControlTime >= CONTROL_LOOP_TIME) {
        float dt = (now - lastControlTime) / 1000.0f;
        lastControlTime = now;

        float gyroRate    = 0;
        float currentAngle = getRoll(gyroRate);

        // Fall detection
        if (fabs(currentAngle) > FALL_ANGLE) {
            if (!robotFallen) {
                robotFallen = true;
                integral = 0;
                updateStepperFrequency(0);
                Serial.println("FALLEN – motors disabled");
            }
        } else {
            robotFallen = false;
        }

        if (!robotFallen) {
            // ── Position PID: compute angle trim from step count ──
            angleTrim = computePositionPID(dt);

            // ── Angle PID: chase (setpoint + position trim) ───────
            float adjustedSetpoint = setpoint + angleTrim;
            float controlSignal = computePID_withSetpoint(currentAngle, gyroRate, dt, adjustedSetpoint);

            motorMixing(controlSignal);
        }

        // Serial plotter (uncomment to monitor):
        // Serial.print("Angle:"); Serial.print(currentAngle, 2);
        // Serial.print(",Trim:"); Serial.print(angleTrim, 3);
        // Serial.print(",Steps:"); Serial.print(positionSteps);
        // Serial.print(",PID:"); Serial.println(pidOutput, 2);
    }
}



// ======================== HELPER FUNCTIONS ========================

void updateStepperFrequency(float frequency) {
    frequency = constrain(frequency, 0, MAX_FREQUENCY);

    if (frequency < 1.0f) {
        esp_timer_stop(stepTimer);
        digitalWrite(PUL1, LOW);
        digitalWrite(PUL2, LOW);
        digitalWrite(ENA1, LOW);
        digitalWrite(ENA2, LOW);
    } else {
        if (frequency < MIN_FREQUENCY) frequency = MIN_FREQUENCY;
        esp_timer_stop(stepTimer);
        int period_us = (int)(500000.0f / frequency);
        esp_timer_start_periodic(stepTimer, period_us);
        digitalWrite(ENA1, HIGH);
        digitalWrite(ENA2, HIGH);
    }
}

// ── Kalman filter ─────────────────────────────────────────────
float getRoll(float &gyroRate) {
    int16_t ax, ay, az, gx, gy, gz;
    mpu.getMotion6(&ax, &ay, &az, &gx, &gy, &gz);

    float dt = (micros() - prevTime) / 1e6f;
    prevTime = micros();
    if (dt <= 0 || dt > 0.05f) dt = 0.005f;

    float accelAngle = atan2(ay, sqrt((float)ax*ax + (float)az*az)) * 180.0f / PI;
    gyroRate = (gx - gyroOffsetX) / 131.0f;

    // Prediction
    angle += (gyroRate - bias) * dt;
    P[0][0] += dt * (dt * P[1][1] - P[0][1] - P[1][0] + Q_angle);
    P[0][1] -= dt * P[1][1];
    P[1][0] -= dt * P[1][1];
    P[1][1] += Q_bias * dt;

    // Update
    float y = accelAngle - angle;
    float S = P[0][0] + R_measure;
    float K[2];
    K[0] = P[0][0] / S;
    K[1] = P[1][0] / S;
    angle += K[0] * y;
    bias  += K[1] * y;
    float P00 = P[0][0], P01 = P[0][1];
    P[0][0] -= K[0] * P00;
    P[0][1] -= K[0] * P01;
    P[1][0] -= K[1] * P00;
    P[1][1] -= K[1] * P01;

    return angle;
}

// ── Position PID ──────────────────────────────────────────────
// Call once per control loop.
// Reads positionSteps (volatile, set in ISR), returns angle trim in degrees.
//
// Tuning guide (after angle PID is stable):
//   1. Set posKp=0, posKi=0, posKd=0 first (position loop OFF).
//   2. Increase posKp slowly (0.0001 steps) until drift is reduced but not oscillating.
//   3. Add posKd (0.00005 steps) to damp oscillation.
//   4. Only add posKi if a steady-state offset remains after Kp+Kd.
//
float computePositionPID(float dt) {
    // Read atomically (disable interrupts briefly on ESP32)
    portDISABLE_INTERRUPTS();
    long steps = positionSteps;
    portENABLE_INTERRUPTS();

    float posError = (float)steps;   // target = 0 steps (stay in place)

    // P
    float pOut = posKp * posError;

    // I (with anti-windup)
    posIntegral += posError * dt;
    posIntegral  = constrain(posIntegral, -MAX_POS_INTEGRAL, MAX_POS_INTEGRAL);
    float iOut   = posKi * posIntegral;

    // D
float rawDeriv = (posError - lastPosError) / dt;
lastPosError = posError;
posDerivFiltered = POS_DERIV_ALPHA * rawDeriv + (1.0f - POS_DERIV_ALPHA) * posDerivFiltered;
float dOut = posKd * posDerivFiltered;

    float trim = (pOut + iOut + dOut);   // negative: fwd drift → lean back
    trim = constrain(trim, -MAX_ANGLE_TRIM, MAX_ANGLE_TRIM);
    return trim;
}

// ── Angle PID (accepts explicit setpoint) ────────────────────
float computePID_withSetpoint(float currentAngle, float gyroRate, float dt, float sp) {
    float error = sp - currentAngle;

    float Pout = Kp * error;

    integral += error * dt;
    integral  = constrain(integral, -MAX_INTEGRAL, MAX_INTEGRAL);
    float Iout = Ki * integral;

    float Dout = -Kd * gyroRate;

    pidOutput = Pout + Iout + Dout;
    return pidOutput;
}

// ── Motor mixing ──────────────────────────────────────────────
void motorMixing(float controlSignal) {
    motorOutput = controlSignal;

    if (fabs(motorOutput) <= DEADBAND) {
        updateStepperFrequency(0);
        return;
    }

    if (motorOutput > 0) {
        digitalWrite(DIR1, HIGH);
        digitalWrite(DIR2, LOW);
        currentDir = 1;
    } else {
        digitalWrite(DIR1, LOW);
        digitalWrite(DIR2, HIGH);
        currentDir = -1;
    }

    float frequency = fabs(motorOutput) * 800.0f;
    frequency = constrain(frequency, MIN_FREQUENCY, MAX_FREQUENCY);
    updateStepperFrequency(frequency);
}

// ── Timer ISR: generate pulses AND count steps ────────────────
// Every toggle is a half-cycle; a full step = two toggles (rising + falling).
// We count on rising edge only (pulseState goes LOW→HIGH).
void IRAM_ATTR stepCallback(void*) {
    pulseState = !pulseState;
    digitalWrite(PUL1, pulseState);
    digitalWrite(PUL2, pulseState);

    // Count position on rising edge of pulse
    if (pulseState) {
        positionSteps += currentDir;
    }
}

// ── Serial command parser ─────────────────────────────────────
void processCommand(String cmd) {
    cmd.trim();
    if      (cmd.startsWith("KP"))   { Kp = cmd.substring(2).toFloat();         Serial.printf("Kp=%.4f\n", Kp); }
    else if (cmd.startsWith("KI"))   { Ki = cmd.substring(2).toFloat();         Serial.printf("Ki=%.4f\n", Ki); }
    else if (cmd.startsWith("KD"))   { Kd = cmd.substring(2).toFloat();         Serial.printf("Kd=%.4f\n", Kd); }
    else if (cmd.startsWith("SP"))   { setpoint = cmd.substring(2).toFloat();   Serial.printf("Setpoint=%.2f\n", setpoint); }
    else if (cmd.startsWith("MAXF")) { MAX_FREQUENCY = cmd.substring(4).toFloat(); Serial.printf("MaxFreq=%.0f\n", MAX_FREQUENCY); }
    else if (cmd.startsWith("MINF")) { MIN_FREQUENCY = cmd.substring(4).toFloat(); Serial.printf("MinFreq=%.0f\n", MIN_FREQUENCY); }
    else if (cmd.startsWith("DB"))   { DEADBAND = cmd.substring(2).toFloat();   Serial.printf("Deadband=%.4f\n", DEADBAND); }
    else if (cmd.startsWith("QA"))   { Q_angle   = cmd.substring(2).toFloat();  Serial.printf("Q_angle=%.6f\n", Q_angle); }
    else if (cmd.startsWith("QB"))   { Q_bias    = cmd.substring(2).toFloat();  Serial.printf("Q_bias=%.6f\n", Q_bias); }
    else if (cmd.startsWith("RM"))   { R_measure = cmd.substring(2).toFloat();  Serial.printf("R_measure=%.6f\n", R_measure); }
    // ── NEW: Position PID commands ──
    else if (cmd.startsWith("PKP"))  { posKp = cmd.substring(3).toFloat();      Serial.printf("posKp=%.6f\n", posKp); }
    else if (cmd.startsWith("PKI"))  { posKi = cmd.substring(3).toFloat();      Serial.printf("posKi=%.6f\n", posKi); }
    else if (cmd.startsWith("PKD"))  { posKd = cmd.substring(3).toFloat();      Serial.printf("posKd=%.6f\n", posKd); }
    else if (cmd == "RESETPOS")      { portDISABLE_INTERRUPTS(); positionSteps = 0; posIntegral = 0; lastPosError = 0; portENABLE_INTERRUPTS();
                                       Serial.println("Position reset to 0"); }
    else if (cmd == "SHOW")  {
        Serial.printf("Angle PID: Kp=%.4f Ki=%.4f Kd=%.4f Setpoint=%.2f\n", Kp, Ki, Kd, setpoint);
        Serial.printf("Motor: MaxFreq=%.0f MinFreq=%.0f Deadband=%.4f\n", MAX_FREQUENCY, MIN_FREQUENCY, DEADBAND);
    }
    else if (cmd == "SHOWK") { Serial.printf("Kalman: Q_angle=%.6f Q_bias=%.6f R_measure=%.6f\n", Q_angle, Q_bias, R_measure); }
    else if (cmd == "SHOWP") { Serial.printf("Pos PID: posKp=%.6f posKi=%.6f posKd=%.6f | Steps=%ld AngleTrim=%.3f\n",
                                             posKp, posKi, posKd, positionSteps, angleTrim); }
    else { Serial.println("Unknown command"); }
}

void readPIDCommands() {
    while (Serial.available()) {
        char c = Serial.read();
        if (c == '\n') { processCommand(serialInput); serialInput = ""; }
        else { serialInput += c; }
    }
}

